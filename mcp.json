{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./notes"],
      "transport": "stdio",
      "tools": [
        { "name": "read_file", "description": "Read a file from the notes directory." },
        { "name": "write_file", "description": "Write a trip note into the notes directory." }
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "transport": "http",
      "tools": [
        { "name": "search_repositories", "description": "Search public repositories." }
      ]
    }
  }
}
